# Environment mode
NODE_ENV=development

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:1234

# Collaboration Server
COLLAB_PORT=1234
COLLAB_HOST=0.0.0.0

# Database (PostgreSQL)
POSTGRES_USER=realcollab
POSTGRES_PASSWORD=realcollab_secret
POSTGRES_DB=realcollab_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://realcollab:realcollab_secret@localhost:5432/realcollab_db?schema=public"

# Redis Cache & Pub/Sub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_URL="redis://:redis_secret@localhost:6379"

# Authentication & Security
AUTH_SECRET=super_secret_session_key_min_32_characters_random_string_fs02
JWT_SECRET=super_secret_jwt_key_min_32_characters_random_string_fs02
SESSION_COOKIE_NAME=realcollab_session
